# Rename this file to .env and fill in your real values.
# Never commit the real .env file to GitHub.

PORT=5000

# Get a free connection string from MongoDB Atlas (https://www.mongodb.com/atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/time-utility

# Any long random string (used to sign login tokens)
JWT_SECRET=replace_this_with_a_long_random_string

# Your OpenWeather API key (https://openweathermap.org/api)
# This key now lives only on the server, never in frontend code.
WEATHER_API_KEY=your_openweathermap_api_key_here

# Where your React app runs, for CORS
CLIENT_URL=http://localhost:5173
